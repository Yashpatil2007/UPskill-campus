
questions = [
    {
        "question": "What is the capital of India?",
        "options": ["A. Mumbai", "B. Delhi", "C. Chennai", "D. Kolkata"],
        "answer": "B"
    },
    {
        "question": "Which language is used for web development?",
        "options": ["A. Python", "B. HTML", "C. Java", "D. C++"],
        "answer": "B"
    },
    {
        "question": "Who is known as the Father of Computers?",
        "options": ["A. Charles Babbage", "B. Alan Turing", "C. Bill Gates", "D. Steve Jobs"],
        "answer": "A"
    },
    {
        "question": "Which planet is called the Red Planet?",
        "options": ["A. Earth", "B. Venus", "C. Mars", "D. Jupiter"],
        "answer": "C"
    },
    {
        "question": "What does CPU stand for?",
        "options": ["A. Central Process Unit", "B. Central Processing Unit", "C. Computer Processing Unit", "D. Control Processing Unit"],
        "answer": "B"
    }
]


def run_quiz(user_answers):
    score = 0

    print("\n===== Welcome to the Quiz Game =====\n")

   
    for i, q in enumerate(questions, start=1):
        print(f"Question {i}: {q['question']}")

    
        for option in q['options']:
            print(option)

        
        user_answer = user_answers[i - 1].upper()
        print(f"Your Answer: {user_answer}")

       
        if user_answer == q['answer']:
            print("Correct Answer!\n")
            score += 1
        else:
            print(f"Wrong Answer! Correct answer is {q['answer']}\n")

  
    print("===== Quiz Completed =====")
    print(f"Your Score: {score}/{len(questions)}")

    percentage = (score / len(questions)) * 100
    print(f"Percentage: {percentage}%")

  
    if percentage >= 80:
        print("Excellent Performance!")
    elif percentage >= 50:
        print("Good Job!")
    else:
        print("Keep Practicing!")

    return score, percentage



print("\n--- Test Case 1 ---")
answers1 = ["B", "B", "A", "C", "B"]
run_quiz(answers1)


print("\n--- Test Case 2 ---")
answers2 = ["A", "B", "C", "D", "B"]
run_quiz(answers2)


print("\n--- Test Case 3 ---")
answers3 = ["A", "A", "B", "A", "C"]
run_quiz(answers3)
